kind = "web"
previewPath = "/"
title = "ᴍᴀᴅᴀʀᴀ x-ᴍᴅ"
description = "A Gen Z WhatsApp bot pairing website for the ᴍᴀᴅᴀʀᴀ x-ᴍᴅ bot. Features a landing page with ads, signup/login/forgot-password auth, a bot pairing page with QR code and connection status indicators (connected/disconnected), a real-time user console log viewer, uptime display, dark/light mode toggle, and social media links (WhatsApp, Instagram, YouTube, TikTok). Branded for ᴍᴀᴅᴀʀᴀ x-ᴍᴅ | ɪɴᴄ. and designed to be Vercel-compatible."
version = "1.0.0"
id = "artifacts/madara-xmd"
router = "path"

[[services]]
name = "web"
paths = [ "/" ]
localPort = 25255

[services.development]
run = "pnpm --filter @workspace/madara-xmd run dev"

[services.production]
build = [ "pnpm", "--filter", "@workspace/madara-xmd", "run", "build" ]
serve = "static"
publicDir = "artifacts/madara-xmd/dist/public"

[[services.production.rewrites]]
from = "/*"
to = "/index.html"

[services.env]
PORT = "25255"
BASE_PATH = "/"
